---
// src/pages/enlaces.astro
// Página PRIVADA de uso interno: lista todos los invitados de
// lista-invitados.txt con su link listo para copiar y mandar por WhatsApp.
// No está enlazada desde ningún lado de la invitación y lleva noindex.
import { getInvitados } from "../data/invitados";

const invitados = getInvitados();
const totalPases = invitados.reduce((suma, inv) => suma + inv.pases, 0);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light only" />
    <title>Enlaces de invitados — Marcela &amp; Fernando</title>
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #f5f0e8;
        color: #5c1f2e;
        font-family: "Cormorant Garamond", Georgia, serif;
        min-height: 100vh;
        padding: 24px 16px 64px;
      }

      .contenedor {
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
      }

      header {
        text-align: center;
        margin-bottom: 24px;
      }

      h1 {
        font-size: 1.6rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #5c1f2e;
      }

      .resumen {
        margin-top: 6px;
        font-size: 0.95rem;
        color: #5c1f2e;
        opacity: 0.75;
      }

      .aviso {
        background: #fff;
        border-left: 3px solid #c8b194;
        padding: 12px 14px;
        margin-bottom: 20px;
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .aviso code {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 0.85em;
        background: #f5f0e8;
        padding: 1px 5px;
        border-radius: 3px;
      }

      ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      li {
        background: #fff;
        border: 1px solid rgba(200, 177, 148, 0.5);
        border-radius: 6px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .datos {
        flex: 1;
        min-width: 0;
      }

      .nombre {
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.2;
      }

      .link {
        display: block;
        margin-top: 2px;
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 0.78rem;
        color: #9a7f84;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .link:hover {
        color: #5c1f2e;
        text-decoration: underline;
      }

      .pases {
        flex-shrink: 0;
        background: #5c1f2e;
        color: #c8b194;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .copiar {
        flex-shrink: 0;
        background: #c8b194;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 9px 14px;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background 0.15s,
          transform 0.1s;
      }

      .copiar:hover {
        background: #b89e7d;
      }

      .copiar:active {
        transform: scale(0.96);
      }

      .copiar.ok {
        background: #5c1f2e;
      }

      .vacio {
        background: #fff;
        border: 1px dashed rgba(200, 177, 148, 0.8);
        border-radius: 6px;
        padding: 28px 18px;
        text-align: center;
        font-size: 1rem;
        line-height: 1.5;
      }

      @media (max-width: 480px) {
        li {
          flex-wrap: wrap;
        }

        .datos {
          flex-basis: 100%;
        }
      }
    </style>
  </head>

  <body>
    <div class="contenedor">
      <header>
        <h1>Enlaces de invitados</h1>
        <p class="resumen">
          {invitados.length}
          {invitados.length === 1 ? "invitación" : "invitaciones"} · {totalPases}
          {totalPases === 1 ? "pase" : "pases"} en total
        </p>
      </header>

      <p class="aviso">
        Página de uso interno. Para agregar o quitar invitados editá <code
          >lista-invitados.txt</code
        > en la raíz del proyecto y volvé a correr <code>npm run build</code>.
        La invitación genérica (sin nombre, 1 pase) es <code>/</code>.
      </p>

      {
        invitados.length === 0 ? (
          <p class="vacio">
            Todavía no hay invitados cargados.
            <br />
            Agregá uno por línea en <code>lista-invitados.txt</code>.
          </p>
        ) : (
          <ul>
            {invitados.map((invitado) => (
              <li>
                <div class="datos">
                  <span class="nombre">{invitado.nombre}</span>
                  <a class="link" href={`/${invitado.slug}/`}>
                    /{invitado.slug}/
                  </a>
                </div>
                <span class="pases">
                  {invitado.pases} {invitado.pases === 1 ? "pase" : "pases"}
                </span>
                <button
                  class="copiar"
                  type="button"
                  data-ruta={`/${invitado.slug}/`}
                >
                  Copiar
                </button>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <script>
      // Copia el link completo (dominio incluido) al portapapeles.
      const botones =
        document.querySelectorAll<HTMLButtonElement>("button.copiar");

      async function copiar(texto: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(texto);
          return true;
        } catch {
          // Respaldo para navegadores viejos o sitios servidos por http://
          try {
            const area = document.createElement("textarea");
            area.value = texto;
            area.style.position = "fixed";
            area.style.opacity = "0";
            document.body.appendChild(area);
            area.select();
            const ok = document.execCommand("copy");
            document.body.removeChild(area);
            return ok;
          } catch {
            return false;
          }
        }
      }

      botones.forEach((boton) => {
        boton.addEventListener("click", async () => {
          const ruta = boton.dataset.ruta;
          if (!ruta) return;

          const url = new URL(ruta, window.location.origin).href;
          const ok = await copiar(url);

          const original = boton.textContent;
          boton.textContent = ok ? "¡Copiado!" : "Copiá a mano";
          boton.classList.toggle("ok", ok);

          setTimeout(() => {
            boton.textContent = original;
            boton.classList.remove("ok");
          }, 1600);
        });
      });
    </script>
  </body>
</html>
