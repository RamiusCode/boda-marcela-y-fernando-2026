---
// TarjetaInvitado.astro — Nombre del invitado y pases asignados
// Si no llega un nombre, se muestra la versión genérica: sin nombre propio,
// sólo "Invitación especial" y la cantidad de pases.
interface Props {
  nombre?: string | null;
  pases?: number;
}

const { nombre = null, pases = 1 } = Astro.props;

const esGenerica = !nombre || nombre.trim() === "";

import { etiquetaPases } from "../lib/pases";
---

<div class="tarjeta-invitado w-full">
  <div
    class="bg-[#5c1f2e] shadow-xl overflow-hidden relative"
    style="border-radius: 6px;"
  >
    <!-- Marco dorado interior -->
    <div class="absolute inset-[7px] border border-[#c8b194]/45 pointer-events-none" style="border-radius: 3px;"></div>

    <div class="px-5 pt-6 pb-16 text-center relative">

      <!-- En la versión genérica estos bloques se renderizan escondidos: si el
           link trae ?i= y el sistema devuelve un nombre, el script los muestra. -->
      <p
        id="texto-para"
        class:list={["font-cormorant text-[13px] text-[#c8b194] uppercase tracking-[0.28em] mb-3", esGenerica && "hidden"]}
      >
        Con mucho cariño para
      </p>

      <div id="separador-arriba" class:list={["flex items-center gap-2", esGenerica ? "mb-4" : "mb-3"]}>
        <div class="flex-1 h-px bg-[#c8b194]/50"></div>
        <span class="text-[#c8b194] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/50"></div>
      </div>

      <p
        id="texto-generico"
        class:list={["font-cormorant text-[15px] leading-tight text-white uppercase tracking-[0.28em] px-1", !esGenerica && "hidden"]}
      >
        Invitación especial
      </p>
      <h2
        id="nombre-invitado"
        class:list={["nombre-invitado font-soage text-[1.2rem] leading-tight text-white px-1", esGenerica && "hidden"]}
      >
        {nombre}
      </h2>

      <div id="separador-abajo" class:list={["flex items-center gap-2 mb-4", esGenerica ? "mt-4" : "mt-3"]}>
        <div class="flex-1 h-px bg-[#c8b194]/50"></div>
        <span class="text-[#c8b194] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/50"></div>
      </div>

      <p id="texto-reservado" class="font-cormorant text-[13px] text-[#c8b194] uppercase tracking-[0.28em] mb-3">
        Hemos reservado
      </p>

      <div id="numero-pase" class="inline-flex items-center gap-2.5 border border-[#c8b194]/60 rounded-full px-7 py-2.5">
        <svg class="w-5 h-5 text-[#c8b194]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20 6h-2.18A3 3 0 0 0 18 5a3 3 0 0 0-5.24-2A5.6 5.6 0 0 0 12 3.9a5.6 5.6 0 0 0-.76-.9A3 3 0 0 0 6 5a3 3 0 0 0 .18 1H4a2 2 0 0 0-2 2v2a1 1 0 0 0 1 1v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a1 1 0 0 0 1-1V8a2 2 0 0 0-2-2Zm-5-2a1 1 0 1 1 0 2h-1.6C13.7 4.9 14.3 4 15 4ZM8 5a1 1 0 0 1 1-1c.7 0 1.3.9 1.6 2H9a1 1 0 0 1-1-1Zm3 14H5v-7h6Zm0-9H4V8h7Zm8 9h-6v-7h6Zm1-9h-7V8h7Z"/>
        </svg>
        <p class="font-cormorant text-base text-[#c8b194] uppercase tracking-[0.18em] font-semibold">
          <span id="numero-pases" class="pases-invitado">{pases}</span>
          <span id="palabra-pases" class="pases-etiqueta">{etiquetaPases(pases)}</span>
        </p>
      </div>

      <p id="texto-pase" class="font-cormorant italic text-[15px] text-white/85 mt-2">
        en su honor
      </p>

    </div>
  </div>
</div>

<style>
  .nombre-invitado {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  /* Cormorant usa cifras de estilo antiguo (más bajas que las mayúsculas);
     forzamos cifras altas para que el número iguale al texto "PASES" */
  .pases-invitado {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum" 1;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { etiquetaPases } from "../lib/pases";
  import { datosInvitado, alCambiarInvitado, type Invitado } from "../lib/invitado";
  gsap.registerPlugin(ScrollTrigger);

  // Personalización por URL: ?invitado=Juan%20Perez&pases=3
  const params = new URLSearchParams(window.location.search);
  const invitado = params.get("invitado");
  const pases = params.get("pases");

  if (invitado) {
    const el = document.querySelector(".nombre-invitado");
    if (el) el.textContent = invitado;
  }

  if (pases) {
    const numero = document.querySelector(".pases-invitado");
    if (numero) numero.textContent = pases;

    const etiqueta = document.querySelector(".pases-etiqueta");
    if (etiqueta) etiqueta.textContent = etiquetaPases(pases);
  }

  // ═══════════════════════════════════════════════════════════
  // SISTEMA DE INVITADOS
  // El link trae solo un código (?i=k7m2p); nombre y pases viven en el panel.
  // Si los novios los corrigen con la invitación abierta, la tarjeta se
  // actualiza sola (alCambiarInvitado). Sin ?i= no se consulta nada y la
  // tarjeta queda como la armó el servidor.
  // Funciones contratadas: nombre y pases.
  // ═══════════════════════════════════════════════════════════

  // Pasa la tarjeta del modo genérico ("Invitación especial") al modo con
  // nombre, con los mismos márgenes que arma el servidor para ese caso.
  function modoConNombre() {
    document.getElementById("texto-para")?.classList.remove("hidden");
    document.getElementById("nombre-invitado")?.classList.remove("hidden");
    document.getElementById("texto-generico")?.classList.add("hidden");

    const arriba = document.getElementById("separador-arriba");
    if (arriba) arriba.classList.replace("mb-4", "mb-3");
    const abajo = document.getElementById("separador-abajo");
    if (abajo) abajo.classList.replace("mt-4", "mt-3");
  }

  function pintarPase(nombre: string | null, cantidad: number | null) {
    if (nombre && nombre.trim()) {
      const el = document.getElementById("nombre-invitado");
      if (el) el.textContent = nombre;
      modoConNombre();
    }

    if (typeof cantidad === "number" && Number.isInteger(cantidad) && cantidad > 0) {
      const num = document.getElementById("numero-pases");
      const palabra = document.getElementById("palabra-pases");
      if (num) num.textContent = String(cantidad);
      // Misma función que usa el servidor: la palabra no puede diferir.
      if (palabra) palabra.textContent = etiquetaPases(cantidad);
    }
  }

  function mostrar(inv: Invitado | null) {
    if (!inv) return;

    // Si la boda no tuviera pases prendidos: solo el nombre, sin un
    // "1 pase" inventado.
    const funciones = (inv.funciones || {}) as { pases?: boolean };
    const sinPases = funciones.pases === false;
    for (const id of ["texto-reservado", "numero-pase", "texto-pase"]) {
      const el = document.getElementById(id);
      if (el) el.style.display = sinPases ? "none" : "";
    }

    pintarPase(inv.nombre, sinPases ? null : inv.pases);
  }

  datosInvitado().then(mostrar);
  alCambiarInvitado((inv) => mostrar(inv));

  gsap.fromTo(
    ".tarjeta-invitado",
    { opacity: 0, y: 40, scale: 0.96 },
    {
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 1.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".tarjeta-invitado",
        start: "top 90%",
        toggleActions: "play none none reset",
      },
    },
  );
</script>
