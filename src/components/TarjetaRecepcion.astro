---
const UBICACION = "https://maps.app.goo.gl/gA94KqPgSNdwzP76A?g_st=aw";
---
<div class="tarjeta-recepcion w-full relative">
  <img
    src="/imagenes/hojaslateral.png"
    alt="Hojas decorativas"
    class="absolute top-16 -left-14 w-[90px] object-contain z-0"
  />
  <div class="bg-[#f5f0e8] shadow-xl overflow-hidden relative z-10" style="border-radius: 90px 90px 0 0;">
    <div class="px-3 pt-8 pb-12 text-center">

      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-0.5">
        Ceremonia
      </h2>
      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-2">
        y Recepción
      </h2>

      <div class="flex justify-center mb-2">
        <img src="/iconos/iglesia.png" alt="Iglesia" class="w-10 h-10 object-contain vino-filter" />
      </div>

      <p class="font-cormorant text-base text-[#c8b194] font-semibold leading-tight mb-1">Salón de Eventos<br/>La Rochelle</p>

      <p class="font-cormorant text-base text-[#5c1f2e] mb-3">Hrs. 17:30</p>

      <a href={UBICACION} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#5c1f2e] text-[#c8b194] border border-[#c8b194]/50 font-cormorant text-xs uppercase px-6 py-2 rounded-full shadow-md hover:bg-[#6e2436] transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Ubicación
      </a>

    </div>
  </div>
</div>

<style>
  .vino-filter {
    filter: brightness(0) saturate(100%) invert(14%) sepia(56%) saturate(1457%) hue-rotate(309deg) brightness(90%) contrast(93%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-recepcion",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-recepcion", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
